NODE_ENV=development
DATABASE_URL=postgresql://lms:lms_local_only@127.0.0.1:55432/zhixue?schema=public
PORT=3001
APP_ORIGIN=http://localhost:5173
# The programming preview uses an isolated hostname, never the LMS hostname.
PROGRAMMING_PREVIEW_PORT=4173
PROGRAMMING_PREVIEW_ORIGIN=http://127.0.0.1:4173
PROGRAMMING_PREVIEW_BIND_HOST=127.0.0.1
COOKIE_SECURE=false
SESSION_HOURS=12
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
MAX_USER_UPLOAD_MB=1024
MAX_ORG_UPLOAD_MB=10240
MAX_USER_UPLOAD_FILES=1000
MAX_ORG_UPLOAD_FILES=20000
MAX_UPLOADS_PER_USER=2
MAX_UPLOADS_TOTAL=8
UPLOADS_PER_MINUTE=20
UNUSED_UPLOAD_TTL_HOURS=24
# Compose production uses a separate restricted runtime database role.
# APP_DATABASE_USER=lms_app
# APP_DATABASE_PASSWORD=
MAX_JSON_MB=2
# Set to 1 only behind the single trusted proxy described in README.
TRUST_PROXY_HOPS=0
MAX_ASSIGNMENT_EXPORT_MB=100
MAX_WEBSOCKETS_PER_USER=20
MAX_WEBSOCKETS_TOTAL=2000
# Configure Judge0 in config.yaml (see config.example.yaml and docs/algorithm-judge.md).
# Optional legacy environment overrides; keep commented when using YAML.
# ALGORITHM_JUDGE_URL=https://judge.example.com
# ALGORITHM_JUDGE_TOKEN=
# ALGORITHM_JUDGE_TIMEOUT_MS=45000
# ALGORITHM_JUDGE_POLL_MS=250
# Override only when the deployed Judge0 uses different language IDs.
# ALGORITHM_JUDGE_LANGUAGE_IDS={"cpp":54,"python":71,"javascript":63,"java":62}
# Development seed only. Set this yourself; the seed rejects production use.
DEV_SEED_PASSWORD=ChangeMe_Dev2026!
# Production bootstrap (no demo users); set both variables in a secure environment.
# BOOTSTRAP_USERNAME=platform-admin
# BOOTSTRAP_PASSWORD=
