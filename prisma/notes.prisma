model LessonNote {
  id String @id @default(cuid())
  organizationId String
  userId String
  courseId String
  lessonId String
  body String
  pinned Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([userId,lessonId])
  @@index([organizationId,userId,pinned,updatedAt,id])
  @@index([courseId,userId])
  @@index([lessonId])
}

model StandaloneNote {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  category       String?
  body           String
  pinned         Boolean  @default(false)
  revision       Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([organizationId, userId, pinned(sort: Desc), updatedAt(sort: Desc), id], map: "StandaloneNote_owner_list_idx")
}
