model MobileCredential {
  sessionId String @id
  session Session @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  accessHash String @unique
  accessExpiresAt DateTime @db.Timestamptz(3)
  refreshHash String @unique
  deviceName String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([accessExpiresAt])
}
model MobileRefreshUse {
  hash String @id
  sessionId String
  session Session @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([sessionId])
  @@index([expiresAt])
}
