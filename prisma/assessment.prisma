model Question {
  id              String   @id @default(cuid())
  organizationId  String
  courseId        String
  chapterId       String?
  creatorId       String
  scope           String   @default("private")
  active          Boolean  @default(true)
  practiceEnabled Boolean  @default(false)
  everPracticeEnabled Boolean @default(false)
  currentVersion  Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  versions        QuestionVersion[]
  @@index([organizationId, courseId, active])
  @@index([creatorId])
}

model QuestionVersion {
  id              String   @id @default(cuid())
  questionId      String
  version         Int
  type            String
  stem            String
  options         Json
  answer          Json
  explanation     String   @default("")
  rules           Json
  scoreCents      Int
  difficulty      Int      @default(2)
  knowledgePoints String[]
  tags            String[]
  children        Json
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  paperItems      PaperItem[]
  assignmentItems AssignmentItem[]
  examItems       ExamPaperItem[]
  @@unique([questionId, version])
  @@index([type, difficulty])
}

model Paper {
  id             String   @id @default(cuid())
  organizationId String
  courseId       String
  creatorId      String
  title          String
  totalCents     Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  items          PaperItem[]
  @@index([organizationId, courseId, createdAt])
}

model PaperItem {
  id                String @id @default(cuid())
  paperId           String
  questionVersionId String
  position          Int
  paper             Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  @@unique([paperId, questionVersionId])
  @@unique([paperId, position])
}

model Assignment {
  id             String @id @default(cuid())
  organizationId String
  courseId       String
  creatorId      String
  title          String
  description    String @default("")
  status         String @default("draft")
  opensAt        DateTime @db.Timestamptz(3)
  dueAt          DateTime @db.Timestamptz(3)
  allowLate      Boolean @default(false)
  maxAttempts    Int @default(1)
  totalCents     Int
  attachmentIds  String[]
  releaseAt      DateTime? @db.Timestamptz(3)
  revision       Int @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  items          AssignmentItem[]
  audience       AssignmentAudience[]
  submissions    AssignmentSubmission[]
  drafts         AssignmentDraft[]
  exceptions     AssignmentException[]
  @@index([organizationId, courseId, status, dueAt])
}

model AssignmentAudience {
  id           String @id @default(cuid())
  assignmentId String
  userId       String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  @@unique([assignmentId, userId])
  @@index([userId])
}

model AssignmentItem {
  id                String @id @default(cuid())
  assignmentId      String
  questionVersionId String
  position          Int
  assignment        Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  @@unique([assignmentId, questionVersionId])
  @@unique([assignmentId, position])
}

model AssignmentDraft {
  id            String @id @default(cuid())
  assignmentId  String
  userId        String
  answers       Json
  attachmentIds String[]
  revision      Int @default(0)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  @@unique([assignmentId, userId])
}

model AssignmentSubmission {
  id             String @id @default(cuid())
  assignmentId   String
  userId         String
  version        Int
  idempotencyKey String
  answers        Json
  attachmentIds  String[]
  submittedAt    DateTime @default(now()) @db.Timestamptz(3)
  late           Boolean
  status         String @default("submitted")
  gradingStatus  String @default("pending")
  scoreCents     Int?
  revision       Int @default(0)
  feedback       String @default("")
  releasedAt     DateTime? @db.Timestamptz(3)
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  grading        AssignmentFeedback[]
  @@unique([assignmentId, userId, version])
  @@unique([assignmentId, userId, idempotencyKey])
  @@index([assignmentId, gradingStatus, submittedAt])
  @@index([userId, submittedAt])
}

model AssignmentFeedback {
  id           String @id @default(cuid())
  submissionId String
  graderId     String
  revision     Int
  items        Json
  comment      String @default("")
  totalCents   Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  @@unique([submissionId, revision])
}

model AssignmentException {
  id           String @id @default(cuid())
  assignmentId String
  userId       String
  approvedBy   String
  reason       String
  allowUntil   DateTime? @db.Timestamptz(3)
  extraAttempts Int @default(0)
  exempt       Boolean @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  @@unique([assignmentId, userId])
}

model PracticeSession {
  id             String @id @default(cuid())
  organizationId String
  courseId       String
  userId         String
  snapshot       Json
  status         String @default("active")
  flags          String[] @default([])
  currentPosition Int @default(0)
  revision       Int @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  answers        PracticeAnswer[]
  @@index([userId, createdAt])
}

model PracticeAnswer {
  id                String @id @default(cuid())
  sessionId         String
  questionVersionId String
  questionId        String
  value             Json
  scoreCents        Int?
  correct           Boolean?
  answeredAt        DateTime @default(now()) @db.Timestamptz(3)
  session           PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, questionVersionId])
  @@index([questionId])
}

model MistakeRecord {
  id           String @id @default(cuid())
  userId       String
  courseId     String
  questionId   String
  wrongCount   Int @default(1)
  mastered     Boolean @default(false)
  lastAnsweredAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([userId, questionId])
  @@index([userId, courseId, lastAnsweredAt])
}

model QuestionFavorite {
  id           String @id @default(cuid())
  userId       String
  courseId     String
  questionId   String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  @@unique([userId, questionId])
  @@index([userId, courseId, createdAt])
}

model Exam {
  id                  String @id @default(cuid())
  organizationId      String
  courseId            String
  creatorId           String
  title               String
  description         String @default("")
  status              String @default("draft")
  startsAt            DateTime @db.Timestamptz(3)
  endsAt              DateTime @db.Timestamptz(3)
  entryClosesAt       DateTime @db.Timestamptz(3)
  durationMinutes     Int
  maxAttempts         Int @default(1)
  shuffleQuestions    Boolean @default(false)
  shuffleOptions      Boolean @default(false)
  allowBacktrack      Boolean @default(true)
  passCents           Int
  totalCents          Int
  graderIds           String[]
  scoreReleaseAt      DateTime? @db.Timestamptz(3)
  answerReleaseAt     DateTime? @db.Timestamptz(3)
  explanationReleaseAt DateTime? @db.Timestamptz(3)
  commentReleaseAt     DateTime? @db.Timestamptz(3)
  appealDeadline      DateTime? @db.Timestamptz(3)
  gradesReleasedAt    DateTime? @db.Timestamptz(3)
  revision            Int @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  audience            ExamAudience[]
  snapshot            ExamPaperSnapshot?
  attempts            ExamAttempt[]
  extensions          ExamExtension[]
  @@index([organizationId, courseId, status, startsAt])
}

model ExamAudience {
  id       String @id @default(cuid())
  examId   String
  userId   String
  eligible Boolean @default(true)
  reason   String?
  exam     Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  @@unique([examId, userId])
  @@index([userId])
}

model ExamPaperSnapshot {
  id         String @id @default(cuid())
  examId     String @unique
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  exam       Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  items      ExamPaperItem[]
}

model ExamPaperItem {
  id                String @id @default(cuid())
  snapshotId        String
  questionId        String
  questionVersionId String
  position          Int
  content           Json
  snapshot          ExamPaperSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  @@unique([snapshotId, questionVersionId])
  @@unique([snapshotId, position])
  @@index([questionId])
}

model ExamAttempt {
  id             String @id @default(cuid())
  examId         String
  userId         String
  number         Int
  status         String @default("in_progress")
  gradingStatus  String @default("pending")
  releaseStatus  String @default("hidden")
  startedAt      DateTime @default(now()) @db.Timestamptz(3)
  deadlineAt     DateTime @db.Timestamptz(3)
  submittedAt    DateTime? @db.Timestamptz(3)
  submissionKey  String?
  revision       Int @default(0)
  gradingRevision Int @default(0)
  scoreCents     Int?
  feedback       String @default("")
  questionOrder  Json
  optionOrder    Json
  flags          String[]
  currentPosition Int @default(0)
  lastSavedAt    DateTime? @db.Timestamptz(3)
  exam           Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  answers        ExamAnswer[]
  grading        GradingRecord[]
  revisions      GradeRevision[]
  appeals        GradeAppeal[]
  @@unique([examId, userId, number])
  @@index([status, deadlineAt])
  @@index([userId, startedAt])
  @@index([examId, gradingStatus])
}

model ExamAnswer {
  id                String @id @default(cuid())
  attemptId         String
  questionVersionId String
  value             Json
  scoreCents        Int?
  graded            Boolean @default(false)
  comment           String @default("")
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  attempt           ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@unique([attemptId, questionVersionId])
}

model GradingRecord {
  id        String @id @default(cuid())
  attemptId String
  graderId  String
  revision  Int
  items     Json
  comment   String @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@unique([attemptId, revision])
}

model GradeRevision {
  id            String @id @default(cuid())
  attemptId     String
  actorId       String
  oldScoreCents Int
  newScoreCents Int
  reason        String
  appealId      String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@index([attemptId, createdAt])
}

model GradeAppeal {
  id         String @id @default(cuid())
  attemptId  String
  userId     String
  reason     String
  status     String @default("pending")
  resolution String?
  resolvedBy String?
  resolvedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@unique([attemptId, userId])
  @@index([status, createdAt])
}

model ExamExtension {
  id            String @id @default(cuid())
  examId        String
  userId        String
  approvedBy    String
  reason        String
  deadlineAt    DateTime @db.Timestamptz(3)
  extraAttempts Int @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  exam          Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  @@unique([examId, userId])
}

model AssessmentJobRun {
  id          String @id @default(cuid())
  type        String
  status      String
  processed   Int @default(0)
  error       String?
  startedAt   DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  @@index([type, startedAt])
}
