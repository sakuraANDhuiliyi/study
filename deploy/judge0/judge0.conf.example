# Administrator configuration, based on Judge0 CE v1.13.1.
# Run scripts/judge0-selfhost.mjs --init to generate a private file on the dedicated VM.
# Keep real credentials out of Git, image layers, command arguments and logs.
JUDGE0_TELEMETRY_ENABLE=false
ENABLE_WAIT_RESULT=false
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_SUBMISSION_DELETE=false
ENABLE_BATCHED_SUBMISSIONS=false
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
SUBMISSION_CACHE_DURATION=0
COUNT=2
MAX_QUEUE_SIZE=32
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=
AUTHZ_HEADER=X-Auth-User
AUTHZ_TOKEN=
REDIS_HOST=redis
REDIS_PASSWORD=
POSTGRES_HOST=db
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=
CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=10
CPU_EXTRA_TIME=0
MAX_CPU_EXTRA_TIME=0
WALL_TIME_LIMIT=6
MAX_WALL_TIME_LIMIT=20
MEMORY_LIMIT=262144
MAX_MEMORY_LIMIT=524288
STACK_LIMIT=64000
MAX_STACK_LIMIT=128000
MAX_PROCESSES_AND_OR_THREADS=60
MAX_MAX_PROCESSES_AND_OR_THREADS=60
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
MAX_FILE_SIZE=1024
# Compilation also uses MAX_* settings; retain 4 MiB for compiler-created files.
MAX_MAX_FILE_SIZE=4096
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false
RAILS_ENV=production
RAILS_MAX_THREADS=4
RAILS_SERVER_PROCESSES=1
SECRET_KEY_BASE=
