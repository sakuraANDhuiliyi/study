# Host-level HTTPS proxy on the dedicated Judge VM. Replace domain, TLS files and LMS IP.
# Do not publish port 2358 or proxy this endpoint from a public browser route.
server {
    listen 443 ssl;
    server_name judge.example.edu;
    ssl_certificate /etc/letsencrypt/live/judge.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/judge.example.edu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Replace with the actual learning-platform backend egress IP, not a whole public subnet.
    allow 203.0.113.10;
    deny all;
    client_max_body_size 8m;
    # Standard combined logs contain no authentication headers. Do not log request bodies/headers.
    access_log /var/log/nginx/judge0-access.log combined;
    error_log /var/log/nginx/judge0-error.log warn;
    location ~ ^/(submissions(/[0-9a-fA-F-]+)?|about|languages|config_info|workers)$ {
        proxy_pass http://127.0.0.1:2358;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Auth-User "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
    location / { return 404; }
}
