# Optional Expo remote notifications. Disabled until all app/server credentials are configured.
MOBILE_PUSH_ENABLED=false
# Public EAS project UUID. Must match the app project configured in Expo and Firebase.
MOBILE_PUSH_EXPO_PROJECT_ID=
# Dedicated random 32-byte key encoded as base64; encrypts device tokens at rest. Keep in secret storage.
MOBILE_PUSH_TOKEN_KEY=
# Optional Expo push access token when enhanced push security is enabled. Server-only secret.
MOBILE_PUSH_EXPO_ACCESS_TOKEN=
# The app also needs its own Firebase google-services.json and Expo FCM v1 credentials.
# Never commit that file or a Firebase service-account private key. No configurable push URL is accepted.
# Existing inbox and local reminders work without remote push. Run background workers to deliver push.
# App build environment (public project ID is not a secret). Explicit opt-in; preview defaults to disabled.
EXPO_PUBLIC_REMOTE_PUSH_ENABLED=false
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_ANDROID_GOOGLE_SERVICES_FILE=
