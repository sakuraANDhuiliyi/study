{
  "name": "zhixue-lms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.11 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run db:generate && npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "lint": "eslint apps tests --no-error-on-unmatched-pattern",
    "format": "prettier --write apps prisma docs tests scripts README.md",
    "db:local": "node scripts/local-postgres.mjs",
    "db:generate": "prisma generate --schema prisma",
    "db:migrate": "node -r dotenv/config node_modules/prisma/build/index.js migrate deploy --schema prisma",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.unit.test.ts",
    "test:e2e": "tsx --test tests/e2e.test.ts",
    "test:performance": "node scripts/performance.mjs",
    "start": "node apps/api/dist/main.js",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test:browser": "playwright test -c playwright.config.ts",
    "test:clean-start": "node scripts/verify-clean-start.mjs",
    "test:assessment": "node --import tsx --test tests/assessment.integration.ts",
    "test:communication": "node --import tsx --test tests/communication.integration.ts",
    "test:security": "node --import tsx --test --test-concurrency=1 tests/*.security.integration.ts",
    "test:security-fixes": "node --import tsx --test --test-concurrency=1 tests/auth-fixes.integration.ts tests/upload-security.integration.ts",
    "test:extensions": "node --import tsx --test --test-concurrency=1 tests/planner.integration.ts tests/notes.integration.ts tests/exam-insights.integration.ts",
    "test:learning-actions": "node --import tsx --test --test-concurrency=1 tests/learning-actions.integration.ts",
    "test:learning-overview": "node --import tsx --test --test-concurrency=1 tests/learning-overview.integration.ts",
    "test:learning-action-filters": "node --import tsx --test --test-concurrency=1 tests/learning-action-filters.integration.ts",
    "test:ai-study": "node --import tsx --test --test-concurrency=1 tests/ai-study.integration.ts",
    "test:ai-authoring": "node --import tsx --test --test-concurrency=1 tests/ai-authoring.integration.ts",
    "test:programming": "node --import tsx --test --test-concurrency=1 tests/programming.integration.ts",
    "test:algorithm-forum": "node --import tsx --test --test-concurrency=1 tests/algorithm-forum.integration.ts",
    "test:creative": "node --import tsx --test --test-concurrency=1 tests/creative.integration.ts",
    "test:algorithms": "node --import tsx --test --test-concurrency=1 tests/algorithms.integration.ts",
    "test:algorithm-training": "node --import tsx --test --test-concurrency=1 tests/algorithm-training-plans.integration.ts",
    "test:minimum-spanning-tree": "node --import tsx --test --test-concurrency=1 tests/minimum-spanning-tree.integration.ts",
    "test:algorithm-history-filters": "node --import tsx --test --test-concurrency=1 tests/algorithm-history-filters.integration.ts",
    "test:accounts": "node --import tsx --test --test-concurrency=1 tests/accounts.integration.ts",
    "test:academics": "node --import tsx --test --test-concurrency=1 tests/academics.integration.ts",
    "test:academic-goals": "node --import tsx --test --test-concurrency=1 tests/academic-goals.integration.ts",
    "test:academic-records-export": "node --import tsx --test --test-concurrency=1 tests/academic-records-export.integration.ts",
    "test:digital-logic": "node --import tsx --test --test-concurrency=1 tests/digital-logic.integration.ts",
    "test:population-genetics": "node --import tsx --test --test-concurrency=1 tests/population-genetics.integration.ts",
    "test:simpson-paradox": "node --import tsx --test --test-concurrency=1 tests/simpson-paradox.integration.ts",
    "test:confusion-matrix": "node --import tsx --test --test-concurrency=1 tests/confusion-matrix.integration.ts",
    "verify:iteration": "node scripts/verify-iteration.mjs",
    "test:algorithm-references": "node scripts/verify-algorithm-references.mjs",
    "test:admin-jobs": "node --import tsx --test tests/admin-jobs.integration.ts",
    "test:admin-audit": "node --import tsx --test tests/admin-audit.integration.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "6.19.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.1",
    "sql.js": "^1.14.2",
    "yaml": "2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^9.2.0",
    "embedded-postgres": "^18.1.0-beta.16",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "prisma": "6.19.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.20.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    },
    "concurrently": {
      "shell-quote": "1.12.0"
    },
    "monaco-editor": {
      "dompurify": "3.4.16"
    }
  }
}
