  "implementation": {
    "behavior": [
      "Filter by all, personal tasks, assignments, or exams, optionally intersected with an enrolled current-organization course.",
      "Personal tasks have no course association; selected course scopes assignments and exams only.",
      "Paginated literal course search returns complete counts, including courses with no current actions.",
      "Retain independent full learning overview, legacy defaults and personal-task completion behavior."
    ],
    "authorization": [
      "learning.use is required for student action lists.",
      "course.read is additionally required for course selection or course-backed action filters; personal/default lists remain available without it.",
      "Every private query rechecks current session, account mode, organization, role, CSRF and permissions after database reads.",
      "Course qualification and page/count snapshots are revalidated; stale private rows and picker names are fenced across identity/permission changes."
    ],
    "persistence": "No schema migration, new dependency, or personal-task course relationship."
  },
